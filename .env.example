# Public base URL used to build canonical URLs, sitemap.xml, and OpenGraph tags.
# Set this to your real production domain before deploying.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Supabase project credentials — find both under
# Supabase Dashboard -> Project Settings -> API
# NEXT_PUBLIC_SUPABASE_URL looks like: https://xxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY is the long "anon public" key (safe to expose
# in the browser — it can only read data, per the RLS policy in
# supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
